;; shadow-cljs build for the public-malak (etzhayyim-wasm-public-malak-pb1ml4k0) appview UI.
;; Mirrors orgs/kotoba-lang/murakumo-studio/shadow-cljs.edn and
;; orgs/cloud-itonami/app-itonami/shadow-cljs.edn:
;; CLJS + reagent on kotoba-ui.core + appkit.core (murakumo-studio構成).
{:deps {:aliases [:cljs]}
 :nrepl {:port 9632}

 :builds
 {:app
  {:target :browser
   :output-dir "web/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn cloud-itonami.public-malak.desktop/init!}}}}}
